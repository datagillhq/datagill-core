# Copy this file to .env and fill in values before running docker compose.
# .env is git-ignored — never commit real credentials.

# App Postgres
APP_POSTGRES_USER=datagill
APP_POSTGRES_PASSWORD=datagill
APP_POSTGRES_DB=datagill

# Connection string used by the app and migrate target.
# For local dev, port 5432 maps to app-postgres inside the compose network.
APP_DATABASE_URL=postgres://datagill:datagill@localhost:5432/datagill?sslmode=disable

# Temporal Postgres (used by the temporal auto-setup container only)
TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_PASSWORD=temporal

# Grafana admin credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Auth — base URL of the BetterAuth handler (no trailing slash).
# The search service appends /.well-known/jwks.json to fetch JWT signing keys.
# For local dev this is the Next.js app running in datagill-ui on port 3001.
AUTH_URL=http://localhost:3001/api/auth

# GitHub App onboarding start flow in Search.
# GITHUB_APP_ID and GITHUB_APP_PRIVATE_KEY_B64 come from GitHub App settings.
# GITHUB_APP_CLIENT_ID / GITHUB_APP_CLIENT_SECRET are used for callback code exchange.
# GITHUB_APP_CALLBACK_URL must match the configured callback URL in the GitHub App.
# FRONTEND_URL is the browser app base URL used for success/error redirects.
# GITHUB_APP_SLUG is the app slug from GitHub App settings.
# GITHUB_APP_STATE_SECRET should be a long random secret used to sign onboarding state.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_B64=
GITHUB_APP_SLUG=
GITHUB_APP_CALLBACK_URL=http://localhost:8082/v1/auth/github
GITHUB_APP_STATE_SECRET=
FRONTEND_URL=http://localhost:3001

# Encryption key for API keys at rest (AES-256-GCM).
# Must be a 64-character hex string (32 bytes). Generate with:
#   openssl rand -hex 32
ENCRYPTION_KEY=
